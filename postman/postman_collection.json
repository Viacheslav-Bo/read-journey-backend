{
  "info": {
    "name": "Read Journey API",
    "description": "Auth, books (Open Library proxy), library, and reading endpoints for the Read Journey backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api-readjourney.viach.dev" },
    { "key": "accessToken", "value": "" },
    { "key": "libraryBookId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get recommended books (no filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Search books by title/author",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?title=harry&author=rowling&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "title", "value": "harry" },
                { "key": "author", "value": "rowling" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "Add book to library",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"totalPages\": 412\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/library",
              "host": ["{{baseUrl}}"],
              "path": ["library"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('libraryBookId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get library (all books)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/library",
              "host": ["{{baseUrl}}"],
              "path": ["library"]
            }
          }
        },
        {
          "name": "Get library filtered by status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/library?status=UNREAD",
              "host": ["{{baseUrl}}"],
              "path": ["library"],
              "query": [{ "key": "status", "value": "UNREAD" }]
            }
          }
        },
        {
          "name": "Delete book from library",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/library/{{libraryBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["library", "{{libraryBookId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reading",
      "item": [
        {
          "name": "Start reading session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/reading/{{libraryBookId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["reading", "{{libraryBookId}}", "start"]
            }
          }
        },
        {
          "name": "Stop reading session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endPage\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reading/{{libraryBookId}}/stop",
              "host": ["{{baseUrl}}"],
              "path": ["reading", "{{libraryBookId}}", "stop"]
            }
          }
        },
        {
          "name": "Get reading stats (sessions)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reading/{{libraryBookId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["reading", "{{libraryBookId}}", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const sessions = pm.response.json();",
                  "  if (sessions.length > 0) {",
                  "    pm.collectionVariables.set('sessionId', sessions[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a diary entry (reading session)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/reading/{{libraryBookId}}/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "reading",
                "{{libraryBookId}}",
                "sessions",
                "{{sessionId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
